# App Backend Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.rioparana.com.ar
EXPO_PUBLIC_APP_API_KEY=

# Supabase Configuration (still used by news and weather caches)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat Configuration
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-ios-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-android-key

# Feature Flags (optional)
EXPO_PUBLIC_MOCK_PURCHASES=true
