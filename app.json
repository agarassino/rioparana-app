{
  "expo": {
    "name": "Paran\u00e1 Info",
    "slug": "rioparana-app",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "rioparana",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3A6070"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syloper.rioparanaapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicaci\u00f3n para mostrarte la estaci\u00f3n del r\u00edo m\u00e1s cercana."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3A6070"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.syloper.rioparanaapp",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5d9f76e-95cc-4cab-8e11-cfb186807082"
      }
    },
    "owner": "agarassino8515"
  }
}
